# Secrets / env
.env

# Neo4j bind mounts (DB data is regenerated by ingestion) + local seed backups
neo4j/data/
neo4j/data.bak-*/
neo4j/data.stale-bak-*/
neo4j/data.dirty-*/
neo4j/data.rehearsal/
neo4j/logs/
neo4j/plugins/
neo4j/import/

# Pipeline intermediates & state
pipeline/data/chunks/
pipeline/data/facts/
pipeline/data/entities/
pipeline/data/checkpoints/
pipeline/data/reports/
pipeline/err.txt

# One-off local swarm utilities (intentionally unversioned; see _memory notes)
pipeline/scripts/_*.py

# Python
.venv/
__pycache__/
*.pyc
.python-version-local

# Node / Next.js
web/node_modules/
web/.next/
web/out/
web/tsconfig.tsbuildinfo
api/.venv/

# Private engineering layer — kept out of the public repo (lives in a private vault)
# and is reached via local symlinks; intentionally NOT part of the public repo.
/AGENTS.md
/.claude/
/.agents/
/.codex/
/specs
/DEPLOY.md

# Cloudflare Worker local dev state
/infra/cloudflare-worker/.wrangler/

# Models cache (HF/MLX downloads live in ~/.cache by default; keep local caches out)
**/.cache/
*.gguf

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
sm-vault/

# Local Neo4j snapshots
backups/

# Cloudflare Tunnel credentials (spec 020). They normally live in ~/.cloudflared,
# never in the repo — this is defense-in-depth in case they're dropped here.
infra/cloudflared/*.json
infra/cloudflared/cert.pem

# BDNS recon (spec 041): crudos del barrido unversioned
pipeline/data/subvenciones/_*

# PLACSP recon (spec 045): dumps ATOM/CODICE + índice local unversioned
pipeline/data/contratacion/_*

# BOE recon (spec 048): sumarios crudos + índice II.A unversioned
pipeline/data/boe/_*

# Repo público = solo lo funcional (decisión 2026-07-23):
# - El trail del QA-audit (ledger, runs, migraciones) es deliberación interna sin revisión
#   editorial línea a línea; no lo lee ningún build/deploy (el seed ya incorpora sus efectos).
# - Los matches*.candidate.yaml son candidatos de recon que JAMÁS se cargan al grafo ni se
#   sirven: contienen terceros (nombre+NIF) que la capa editorial decidió no señalar.
# Ambos viven solo en disco local / linaje privado.
pipeline/data/audit/
pipeline/data/*/matches*.candidate.yaml

# Apply de la 063 (qa_esc_apply._escribir_todo): temporales (sufijo por ejecución), copias y marcador de un apply en
# curso o interrumpido, que el apply borra al terminar o al deshacerse (si quedan son solo locales), y el fichero del
# bloqueo que comparten check/apply/record (`_bloqueo`), que se queda.
pipeline/data/*/*.yaml.*.tmp
pipeline/data/*/*.yaml.bak
pipeline/data/rectificaciones/.apply-en-curso.json
pipeline/data/rectificaciones/apply.lock

# Revisión legal pre-publicación (decisión 2026-08-03): los informes policiales/
# administrativos de sumario (UCO/UDEF/atestado GC/AEAT) y la edición de periódico
# NO se redistribuyen crudos en el repo público — el sitio sirve su texto troceado
# con cita (art. 85 RGPD), pero el PDF íntegro es filtración con datos personales
# masivos de terceros (o, en el caso del periódico, obra protegida del editor).
# Quedan en disco local + copia privada en R2; censo y procedencia en data/SOURCES.md.
data/informe-uco.pdf
data/informe-uco-cerdan-*.pdf
data/informe-udef-*.pdf
data/informe_guardia_civil.pdf
data/Informe-InstruccionN3.pdf
data/2025-04-29-badajoz-1-pdf-2.pdf
# Resoluciones difundidas por la prensa (SOURCES.md §3) que contienen identificadores de personas físicas
# (DNI, teléfonos, domicilios) que el sitio redacta al servir el texto pero que un PDF crudo no permite
# redactar (escaneo 2026-10-05 con las reglas de api/app/redact.py). Mismo régimen que los informes.
data/aldama-movil.pdf
data/2024-10-23-Exposicion-razonada-Abalos.pdf
data/auto-peinado-juicio-oral-begona-2026-06-20.pdf
data/auto-zapatero-joyas-2026-06-12.pdf
data/auto-zapatero.pdf
data/sentencia-ts-abalos-koldo-aldama-2026-06-22.pdf
data/sentencia-ts-garcia-ortiz-fiscal-general.pdf

# staging local de PDFs pendientes de ingesta (censo en BACKLOG.md; no redistribuir hasta pasar el gate editorial)
data/incoming/
AGENTS.md
# seeds locales, stores efímeros y exports del censo (spec 060/061) — nunca al repo
neo4j/*.tgz
neo4j/data.*/
neo4j/integral-*/
.wrangler/

# Playwright: config local y salidas de playwright-cli; resultados de la suite e2e de la web
/.playwright/
.playwright-cli/
web/test-results/
web/playwright-report/
