{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus (Grafana Cloud)",
      "type": "datasource",
      "pluginId": "prometheus",
      "description": "El datasource grafanacloud-*-prom donde escribe la integración Metrics Endpoint"
    }
  ],
  "uid": "sm-mcp-cloud",
  "title": "El Entramado — MCP público (Cloud)",
  "tags": ["entramado", "observabilidad", "mcp"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Llamadas a herramientas (24h)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(mcp_tool_calls_total[24h]))" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Rechazos por rate-limit (24h)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(mcp_rate_limited_total[24h]))" }
      ]
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Herramientas más usadas (24h)",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "topk(10, sum by (tool) (increase(mcp_tool_calls_total[24h])))", "legendFormat": "{{tool}}", "instant": true }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Llamadas/s por herramienta",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "sum by (tool) (rate(mcp_tool_calls_total[5m]))", "legendFormat": "{{tool}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latencia p95 por herramienta (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(mcp_tool_duration_seconds_bucket[5m])))", "legendFormat": "{{tool}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Errores de herramienta/s (outcome != ok)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "sum by (tool, outcome) (rate(mcp_tool_calls_total{outcome!=\"ok\"}[5m]))", "legendFormat": "{{tool}} ({{outcome}})" }
      ]
    }
  ]
}
