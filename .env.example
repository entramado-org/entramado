# Copy to .env and adjust. Loaded by docker-compose.

# --- Neo4j ---
# Use a strong random value in production.
NEO4J_PASSWORD=changeme
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j

# --- Web (local dev only) ---
# Browser hits the API via the published host port, NOT the compose service name.
# In production the web image is built with NEXT_PUBLIC_API_BASE=/api (same-origin
# through Caddy), so this dev value is not used by docker-compose.prod.yml.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Production hosting (docker-compose.prod.yml) ---
# Public hostname for TLS. With no domain, use <vps-ip>.sslip.io (resolves to the IP).
# On the sm-prod machine Caddy serves :80 as a catch-all behind the Tailscale Funnel
# AND the Cloudflare Tunnel (entramado.org, spec 020) — the custom domain needs NO
# change here (TLS terminates at the respective edges; see infra/cloudflared/README.md).
SITE_HOST=
# Basic Auth credentials. UNUSED since 2026-06-25: the site is PUBLIC (the
# basicauth block was removed from the Caddyfile; abuse is bounded by a per-IP
# rate limit instead). Kept wired for an easy rollback — to password-protect the
# site again, re-add the @protegido + basicauth block in the Caddyfile and set
# the hash below. /mcp would stay exempt by design.
# Generate the hash: docker run --rm caddy caddy hash-password --plaintext '<password>'
BASIC_AUTH_USER=amigos
BASIC_AUTH_HASH=

# (The observability stack vars — GRAFANA_ADMIN_PASSWORD, MAXMIND_LICENSE_KEY —
# were removed with specs 017/018: prod metrics live in Grafana Cloud since
# spec 057, scraping entramado.org/metrics/{api,mcp}. See DEPLOY.md §B.9 (private ops runbook).)

# Jev (TypeSafe System One), segundo lector de la auditoría dual (addendum 061-B)
TYPESAFE_API_KEY=
