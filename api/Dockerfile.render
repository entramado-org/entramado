# Render variant of Dockerfile.prod. Build context = REPO ROOT (not ./api):
# Render has no bind mounts, so the última-hora feed and patrones YAML are baked
# into the image at the same paths the app already reads (/data/...). A feed
# merge to main triggers a Render auto-deploy instead of the old `git pull`.
# The vault (sm-vault, gitignored) is fetched from R2 at boot by the entrypoint.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app
COPY api/pyproject.toml api/uv.lock ./
RUN uv sync --frozen --no-install-project

COPY api/app ./app
COPY pipeline/data/ultima_hora /data/ultima_hora
COPY pipeline/data/patrones /data/patrones
# Controlled vocabulary (spec 069): statuses, layers and entity types served by API and MCP.
COPY pipeline/data/ontologia /data/ontologia

COPY infra/render/api-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000
# No ENTRYPOINT: sm-mcp overrides the whole command via dockerCommand, and
# wrapping explicitly (`/entrypoint.sh uvicorn …`) keeps both services
# deterministic regardless of how Render composes entrypoint vs command.
CMD ["/entrypoint.sh", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
